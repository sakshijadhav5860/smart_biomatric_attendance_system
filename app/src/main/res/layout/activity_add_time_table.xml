<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TimeTable.AddTimeTableActivity"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Spinner
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:id="@+id/spinner_branch"
            android:entries="@array/branch" />
        <Spinner
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:id="@+id/spinner_teacher_semester"
            android:entries="@array/semester"
            />

        <Button
            android:id="@+id/btn_attach_time_table"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/btn_bg"
            android:text="Attach Time Table"
            android:textAllCaps="false"
            android:textColor="#ffff"
            android:textSize="16dp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_add_time_table"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/btn_bg"
            android:text="Add Time Table"
            android:textAllCaps="false"
            android:textColor="#ffff"
            android:textSize="16dp"
            android:textStyle="bold" />

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/progress"
            android:layout_centerInParent="true"
            android:indeterminateTint="@color/purple_700"
            android:visibility="gone"/>

    </LinearLayout>

</ScrollView>